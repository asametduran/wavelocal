{
  "name": "zero-ad-mp3-player",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "size": "node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "node desktop/scripts/dev.mjs",
    "desktop:build": "npm run build && npm --prefix desktop run build",
    "desktop:start": "npm run build && npm --prefix desktop run start",
    "desktop:test": "npm run desktop:build && playwright test -c desktop",
    "typecheck:desktop": "npm --prefix desktop run typecheck",
    "desktop:dist": "npm run build && npm --prefix desktop run dist",
    "desktop:pack": "npm run build && npm --prefix desktop run pack"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
